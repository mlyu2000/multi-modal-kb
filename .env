# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trading_kb_password

# ChromaDB
CHROMA_PERSIST_DIR=/home/ml/trading_kb/db/chroma

# SQLite
SQLITE_PATH=/home/ml/trading_kb/db/metadata.sqlite

# Qwen3 Next 80B (via LiteLLM proxy)
# Available model from proxy: qwen3-coder-next-awq-4bit
QWEN_API_BASE=http://127.0.0.1:4000/v1
QWEN_API_KEY=sk-12345
QWEN_MODEL=qwen3-coder-next-awq-4bit

# Gemma4 31B (via LiteLLM proxy)  
# Available model from proxy: gemma-4-31B-it-AWQ-4bit
GEMMA_API_BASE=http://127.0.0.1:4000/v1
GEMMA_API_KEY=sk-12345
GEMMA_MODEL=gemma-4-31B-it-AWQ-4bit

# Transcription
WHISPER_MODEL=medium
DEVICE=auto

# Extraction settings
FRAME_INTERVAL_SECONDS=5
SEGMENT_MIN_SECONDS=60
SEGMENT_MAX_SECONDS=180
