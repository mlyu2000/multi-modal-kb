# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trading_kb_password

# ChromaDB
CHROMA_PERSIST_DIR=./db/chroma

# SQLite
SQLITE_PATH=./db/metadata.sqlite

# Qwen3 Next 80B compatible API (Ollama compatible)
QWEN_API_BASE=http://localhost:11434/v1
QWEN_API_KEY=local
QWEN_MODEL=qwen3-next-80b

# Gemma4 31B compatible API (Ollama compatible)
GEMMA_API_BASE=http://localhost:11434/v1
GEMMA_API_KEY=local
GEMMA_MODEL=gemma4-31b

# Transcription
WHISPER_MODEL=medium
DEVICE=auto

# Extraction settings
FRAME_INTERVAL_SECONDS=5
SEGMENT_MIN_SECONDS=60
SEGMENT_MAX_SECONDS=180
